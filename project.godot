[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="players"
3d_render/layer_1="world"
3d_render/layer_2="viewmodel"

[netfox]

general/clear_settings=false
logging/log_level=2
logging/netfox_log_level=2
time/tickrate=60
time/sync_to_physics=true
time/suppress_offline_peer_warning=true
time/tickrate_mismatch_action=1
rollback/history_limit=128
rollback/state_send_interval=2
rollback/input_redundancy=4
rollback/enable_diff_states=true
rollback/input_delay=0
rollback/display_offset=0
extras/auto_tile_windows=false
autoconnect/enabled=false

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"
3d/default_gravity=12.5

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=0
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=0
environment/defaults/default_clear_color=Color(0.72, 0.62, 0.48, 1)
textures/default_filters/anisotropic_filtering_level=0
